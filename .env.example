# HackNest backend base URL used by the custom portal integration page
VITE_HACKNEST_API=http://localhost:8000

# HackNest frontend base URL used to redirect to original HackNest team portal on secret issues
VITE_HACKNEST_FRONTEND_URL=http://localhost:3000

# Per-hackathon integration secret configured in HackNest dashboard
VITE_HACKNEST_INTEGRATION_SECRET=youralphanumericsecret
